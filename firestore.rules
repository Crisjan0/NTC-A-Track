rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Provisioned role ('admin' | 'student') for the caller, or '' when
    // the account was never provisioned (e.g. self-signed-up).
    function myRole() {
      return get(
        /databases/$(database)/documents/roles/$(request.auth.uid)
      ).data.get('kind', '');
    }

    function isAdmin() {
      return signedIn() && myRole() == 'admin';
    }

    function isMember() {
      return signedIn() && (myRole() == 'admin' || myRole() == 'student');
    }

    // Login directory: maps a username / student ID to its current
    // Firebase Auth email. Contains NO secrets, so anyone may look up
    // the entry for the account they are logging into. Listing all
    // entries stays forbidden; writes are admin-only.
    match /authdir/{doc} {
      allow get: if true;
      allow list: if false;
      allow create, update, delete: if isAdmin();
    }

    // Role records keyed by Auth uid. Users may read their own record
    // (needed at login); only admins may write.
    match /roles/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if false;
      allow create, update, delete: if isAdmin();
    }

    // Admin accounts: admins only.
    match /users/{doc} {
      allow read, write: if isAdmin();
    }

    // Students, courses, events, attendance: both roles may read
    // (students only ever see their own data through app queries);
    // only admins may write.
    match /students/{doc} {
      allow read: if isMember();
      allow write: if isAdmin();
    }
    match /courses/{doc} {
      allow read: if isMember();
      allow write: if isAdmin();
    }
    match /events/{doc} {
      allow read: if isMember();
      allow write: if isAdmin();
    }
    match /attendance/{doc} {
      allow read: if isMember();
      allow write: if isAdmin();
    }
  }
}
